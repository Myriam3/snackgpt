<div class="container">
  <h1 class="text-center mt-5">Meals</h1>

  <h2 class="text-center mt-5">Date: <%= @date %></h2>

  <% if @meals %>
    <ol class="row list-unstyled mt-3">
    <% @meals.each do |meal| %>
      <div class="col-md-6 offset-md-3">
        <li class="my-3">
          <div class="card">
            <h3 class="card-header text-center text-white bg-secondary"><%= meal.meal_type.capitalize %></h3>
            <div class="card-body">
              <%# <h4 class="card-title">Special title treatment</h4> %>
              <p class="card-text"><%= meal.content %></p>
              <div class="text-center"><a href="/meal/<%= meal.id %>" class="btn btn-primary">Details</a></div>
              <div class="form-check mt-5">
                <input type="checkbox" class="form-check-input" id="mealComplete-<%= meal.id %>">
                <label class="form-check-label" for="mealComplete-<%= meal.id %>">Complete</label>
              </div>
            </div>
            <div class="card-footer text-muted">
              <dl class="list-unstyled mb-0 container">
                <div class="row">
                  <div class="d-flex">
                    <dt class="m-1">Calories:</td>
                    <dd class="m-1"><%= meal.calories %></dd>
                  </div>
                  <div class="progress">
                    <div class="progress-bar" role="progressbar" style="width: 25%;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">25%</div>
                  </div>
                </div>
                <div class="row mt-3">
                  <div class="col">
                    <dt>Protein:</td>
                    <dd><%= meal.protein %></dd>
                    <dd>
                      <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 20%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">20%</div>
                      </div>
                    </dd>
                  </div>
                  <div class="col">
                    <dt>Carbs:</td>
                    <dd><%= meal.carbs %></dd>
                    <dd>
                      <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 35%;" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100">35%</div>
                      </div>
                    </dd>
                  </div>
                  <div class="col">
                    <dt>Fats:</td>
                    <dd><%= meal.fats %></dd>
                    <dd>
                      <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 15%;" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100">15%</div>
                      </div>
                    </dd>
                  </div>
                </div>
              </dl>

            </div>
          </div>
        </li>
      </div>
    <% end %>
    </ol>
  <% end %>
</div>
