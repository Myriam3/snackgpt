<div class="container">
  <h1 class="text-center mt-5">Journal: <%= @date %></h1>

  <h2 class="text-center mt-5">My objectives</h2>
  <%= turbo_frame_tag "daily_objective" do %>
    <%= render "shared/daily_objective" %>
  <% end %>

  <h2 class="text-center mt-5">Meals</h2>

  <% if @meals %>
    <ol class="row list-unstyled">
    <% @meals.each do |meal| %>
      <%= turbo_frame_tag dom_id(meal) do %>
        <%= render "meal_card", meal: meal %>
      <% end %>
    <% end %>
    </ol>
  <% end %>
</div>
