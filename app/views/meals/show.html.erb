<div class="meal-details-page">
  <% if @meal %>
    <div class="meal-details-shell">
      <%= link_to "← Back to meals",
                  meals_path(date: @meal.date),
                  class: "meal-details__back" %>

      <header class="meal-details__header">
        <p class="meal-details__eyebrow">
          <%= @meal.meal_type.capitalize %>
        </p>

        <h1><%= @meal.meal_title %></h1>

        <p class="meal-details__date">
          <%= @meal.date.strftime("%A, %B %-d") %>
        </p>

        <%= turbo_frame_tag "meal_completed" do %>
          <% if @meal.completed %>
            <span class="meal-details__status">
              Completed
            </span>
          <% end %>
        <% end %>
      </header>

      <%= simple_form_for @meal,
          url: complete_meal_path(@meal),
          method: :patch,
          html: {
            data: { controller: "meals" },
            class: "meal-details__complete-form",
            autocomplete: "off"
          } do |f| %>
        <%= f.input :completed,
            as: :boolean,
            label: @meal.completed ? "Completed - nice work!" : "Mark this meal as eaten",
            wrapper_html: { class: "meal-details__complete" },
            input_html: {
              data: { action: "change->meals#complete" },
              id: "meal_#{@meal.id}_completed"
            } %>
      <% end %>

      <section class="meal-details__content">
        <h2>What to eat</h2>

        <div class="meal-details__content-body">
          <%= @meal.content.html_safe %>
        </div>
      </section>

      <section class="meal-details__nutrition">
        <h2>Nutrition</h2>

        <%= render "meal_objective", meal: @meal %>
      </section>

      <%= link_to "7 days",
                meal_chat_path(range: "week", anchor: "progress"),
                class: @range == "week" ? "btn btn-primary" : "btn btn-secondary"
      %>

      <%= link_to meal_chat_path(@meal),
        class: "dashboard-suggestion mt-5" do %>
          <span class="dashboard-suggestion__icon" aria-hidden="true">✦</span>
          <div>
            <p class="dashboard-eyebrow">Your meals suggestions</p>
            <p class="h2">Edit meals</p>
          </div>
        <span class="dashboard-suggestion__arrow" aria-hidden="true">→</span>
    <% end %>
    </div>
  <% end %>
</div>
