<div class="meal-card">
  <div class="meal-card__header">
    <span class="meal-card__type">
      <%= meal.meal_type.capitalize %>
    </span>

    <% if meal.completed %>
      <span class="meal-card__status">Completed</span>
    <% end %>
  </div>

  <div class="meal-card__body">
    <h3><%= meal.meal_title %></h3>

    <% if meal.content.present? %>
      <p class="meal-card__summary">
        <%= strip_tags(meal.content).truncate(100) %>
      </p>
    <% end %>

    <%= simple_form_for meal,
        url: complete_meal_path(meal),
        method: :patch,
        html: {
          data: { controller: "meals" },
          class: "meal-card__complete-form",
          autocomplete: "off"
        } do |f| %>

      <%= f.input :completed,
          as: :boolean,
          label: meal.completed ? "Completed" : "Mark as eaten",
          wrapper_html: { class: "meal-card__complete" },
          input_html: {
            data: { action: "change->meals#complete" },
            id: "meal_#{meal.id}_completed"
          } %>
    <% end %>

    <div class="meal-card__footer">
      <span class="meal-card__calories">
        <strong><%= meal.calories %></strong> kcal
      </span>

      <%= link_to "Details",
                  meal_path(meal),
                  data: { turbo_frame: "_top" },
                  class: "meal-card__button" %>
    </div>
  </div>

  <div class="meal-card__objective">
    <%= render "meals/meal_objective", meal: meal %>
  </div>
</div>
