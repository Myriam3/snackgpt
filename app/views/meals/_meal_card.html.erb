<div class="col-md-6 offset-md-3">
  <li class="my-3">
    <div class="card">
      <h3 class="card-header text-center text-white <% if meal.completed %>bg-success<% else %>bg-secondary<% end%>">
        <%= meal.meal_type.capitalize %>
      </h3>
      <div class="card-body">
        <%
          max = 100
          content = meal.content.html_safe
          short_content = content[0...max]
        %>

        <div class="form-check mb-3">
          <%= simple_form_for meal,
              url: complete_meal_path(meal),
              method: :patch,
              html: { data: { controller: "meals" }, autocomplete: "off" } do |f| %>
            <%= f.input :completed,
                as: :boolean,
                input_html: { data: { action: "change->meals#complete" }, id: "meal_#{meal.id}_completed" } %>
          <% end %>
        </div>
        <h4 class="card-title"><%= meal.meal_title %></h4>
        <div class="text-center">
          <%= link_to "Details", meal_path(meal), data: { turbo_frame: "_top" }, class: "btn btn-primary" %>
        </div>
      </div>
      <div class="card-footer text-muted bg-white">
        <%= render 'meals/meal_objective', meal: meal %>
      </div>
    </div>
  </li>
</div>
