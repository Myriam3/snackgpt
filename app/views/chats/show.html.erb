<%# app/views/chats/show.html.erb %>
<div id="chatbot-container" data-controller="chatbot" class="chat-wrapper">
  <div id="chat-window" data-chatbot-target="window" class="chat-window">
    <div class="bot-msg">Hello! How can I help you today?</div>
  </div>

  <div class="chat-input-area">
    <input type="text" id="user-input" data-chatbot-target="input" placeholder="Type a message...">
    <button type="button" data-action="click#chatbot#send">Send</button>
  </div>
</div>
