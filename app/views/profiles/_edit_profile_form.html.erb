<%= simple_form_for profile do |f| %>
  <%= render "profiles/basic_info", f: f %>
  <%= render "profiles/allergies", f: f %>
  <%= render "profiles/cooking_devices", f: f %>
  <%= render "profiles/preferences", f: f %>
  <%= render "profiles/condition", f: f %>
  <%= render "profiles/activity_level", f: f %>
  <%= render "profiles/goal", f: f %>

  <%= f.button :submit, "Save changes", class: "btn btn-primary text-white" %>
  <%= link_to "Cancel", profile_path, class: "btn btn-primary text-white" %>
<% end %>
