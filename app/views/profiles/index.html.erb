<% content_for :title, "Dashboard | SnackGPT" %>

<%
  objective_cards = [
    {
      label: "Calories",
      # value: @response["daily_objectives"]["calories"],
      unit: "kcal",
      icon: "🔥",
      accent: "paprika"
    },
    {
      label: "Protein",
      # value: @response["daily_objectives"]["protein"],
      unit: "g",
      icon: "💪",
      accent: "moss"
    },
    {
      label: "Carbs",
      # value: @response["daily_objectives"]["carbs"],
      unit: "g",
      icon: "🌾",
      accent: "honey"
    },
    {
      label: "Fats",
      # value: @response["daily_objectives"]["fats"],
      unit: "g",
      icon: "🥑",
      accent: "mint"
    }
  ]

  snacks = [
    {
      name: "Apple + almond butter",
      detail: "320 kcal · 6g protein",
      icon: "🍎"
    },
    {
      name: "Greek yogurt",
      detail: "210 kcal · 12g protein",
      icon: "🥣"
    },
    {
      name: "Trail mix",
      detail: "280 kcal · 7g protein",
      icon: "🥜"
    }
  ]
%>

<div class="dashboard-page">
  <div class="dashboard-shell">
    <%= render 'shared/sidebar' %>

    <main class="dashboard-content">
      <!-- <header class="dashboard-header">
        <div>
          <p class="dashboard-eyebrow">Your snack dashboard</p>
          <h1>Good morning, Test</h1>
          <p>Small choices add up. Let’s make today a good one.</p>
        </div>

        <div class="dashboard-avatar" aria-hidden="true">
          L
        </div>
      </header> -->
      <div data-controller="clear-session">
        <p class="dashboard-eyebrow">Dashboard</p>
        <h1>Hello, <%= @profile.name %> </h1>

        <section class="dashboard-overview" id="objectives">
          <div class="dashboard-progress-card">
            <div class="dashboard-card__heading">
              <h2>Daily progress</h2>
              <span>Today</span>
            </div>

            <div class="dashboard-progress-card__value">
              <strong>68%</strong>
              <span>of your daily goals</span>
            </div>

            <div
              class="dashboard-progress-bar"
              role="progressbar"
              aria-label="Daily nutrition progress"
              aria-valuenow="68"
              aria-valuemin="0"
              aria-valuemax="100">
              <span style="width: 68%"></span>
            </div>
          </div>

          <div class="dashboard-objectives-card">
            <div class="dashboard-card__heading">
              <h2>Today’s objectives</h2>
              <span>Daily targets</span>
            </div>

            <div class="dashboard-objectives-grid">
              <% objective_cards.each do |card| %>
                <article class="dashboard-stat-card">
                  <span
                    class="dashboard-stat-card__icon dashboard-stat-card__icon--<%= card[:accent] %>"
                    aria-hidden="true">
                    <%= card[:icon] %>
                  </span>

                  <p><%= card[:label] %></p>

                  <strong>
                    <%= number_with_delimiter(card[:value]) %>
                    <small><%= card[:unit] %></small>
                  </strong>

                  <div class="dashboard-stat-card__bar">
                    <span></span>
                  </div>
                </article>
              <% end %>
            </div>
          </div>
        </section>

        <section id="progress">
          <h2 class="mt-5">Your progress</h2>

          <div class="dashboard-range mt-4 mb-5">
            <%= link_to "7 days",
                profile_path(range: "week", anchor: "progress"),
                class: @range == "week" ? "btn btn-primary" : "btn btn-secondary"
            %>

            <%= link_to "1 month",
                profile_path(range: "month", anchor: "progress"),
                class: @range == "month" ? "btn btn-primary" : "btn btn-secondary"
            %>

            <%= link_to "3 months",
                profile_path(range: "three_months", anchor: "progress"),
                class: @range == "three_months" ? "btn btn-primary" : "btn btn-secondary"
            %>
          </div>

          <%= render 'profile_summary' %>
          <%= render 'profile_calories' %>
          <%= render 'profile_macro' %>
        </section>

        <section id="profile">
          <h2 class="dashboard-title dashboard-title--profile">Your profile</h2>

          <div class="dashboard-grid dashboard-grid--profile mt-4">
            <div class="dashboard-grid__card">
              <div class="card h-100">
                <div class="card-body text-center">
                  <h3 class="card-title text-primary">Goal</h3>
                  <p><%= @profile.goal.humanize %></p>
                </div>
              </div>
            </div>
            <div class="dashboard-grid__card">
              <div class="card h-100">
                <div class="card-body text-center">
                  <h3 class="card-title text-primary">Activity level</h3>
                  <p><%= @profile.activity_level.humanize %></p>
                </div>
              </div>
            </div>

            <div class="dashboard-grid__card dashboard-grid__card--result">
              <div class="card">
                <div class="card-body">
                  <%= turbo_stream_from @profile %>
                    <div id="nutrition_plan">
                      <% if @profile.daily_objective.present? %>
                        <%= render "nutrition_plan",
                        daily_objective: @profile.daily_objective,
                        meals: @profile.meals %>
                      <% else %>
                      <div class="text-center fw-bold fs-5 text-primary">
                        <%= render "profiles/nutrition_loading" %>
                      </div>
                      <% end %>
                    </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="dashboard-suggestion mt-5">
          <span class="dashboard-suggestion__icon" aria-hidden="true">✦</span>

          <div>
            <p class="dashboard-eyebrow">Your meals suggestions</p>
            <p class="h2">Add/edit meals</h2>
          </div>

          <span class="dashboard-suggestion__arrow" aria-hidden="true">→</span>
        </div>
      </div>
    </main>
  </div>
</div>
