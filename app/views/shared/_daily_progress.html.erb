<div class="daily-progress">
  <div class="row">
    <div class="col">
      <h3>Calories</h3>
      <p class="m-0"><span><%= @daily_progress[:calories][:total] %></span>/<%= @daily_objective.calories %></p>
      <div class="progress" role="progressbar" aria-label="Calories progress" aria-valuenow="<%= @daily_progress[:calories][:percent] %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= @daily_progress[:calories][:percent] %>%"></div>
      </div>
    </div>
  </div>
  <div class="row gx-3 mt-4">
    <div class="col">
      <h4>Protein</h4>
      <p class="m-0"><span><%= @daily_progress[:protein][:total] %></span>/<%= @daily_objective.protein %></p>
      <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="<%= @daily_progress[:protein][:percent] %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar flex-row" style="width: <%= @daily_progress[:protein][:percent] %>%"></div>
      </div>
    </div>

    <div class="col">
      <h4>Carbs</h4>
      <p class="m-0"><span><%= @daily_progress[:carbs][:total] %></span>/<%= @daily_objective.carbs %></p>
      <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="<%= @daily_progress[:carbs][:percent] %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= @daily_progress[:carbs][:percent] %>%"></div>
      </div>
    </div>

    <div class="col">
      <h4>Fats</h4>
      <p class="m-0"><span><%= @daily_progress[:fats][:total] %></span>/<%= @daily_objective.fats %></p>
      <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="<%= @daily_progress[:fats][:percent] %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= @daily_progress[:fats][:percent] %>%"></div>
      </div>
    </div>
  </div>
</div>
